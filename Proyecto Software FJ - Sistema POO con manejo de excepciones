"""
logger.py
=========
Sistema de registro de eventos y errores para Software FJ.
Escribe en archivo de logs con marca de tiempo y nivel de severidad.
"""

import logging
import os
from datetime import datetime

# Directorio donde se guardan los logs (mismo nivel que el script principal)
LOG_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "logs")
LOG_FILE = os.path.join(LOG_DIR, "softwarefj.log")


def _inicializar_logger() -> logging.Logger:
    """Configura y devuelve el logger principal del sistema."""
    os.makedirs(LOG_DIR, exist_ok=True)

    logger = logging.getLogger("SoftwareFJ")
    logger.setLevel(logging.DEBUG)

    # Evitar handlers duplicados si el módulo se recarga
    if logger.handlers:
        return logger

    # Handler de archivo — registra TODO
    fh = logging.FileHandler(LOG_FILE, encoding="utf-8")
    fh.setLevel(logging.DEBUG)

    # Handler de consola — muestra WARNING en adelante
    ch = logging.StreamHandler()
    ch.setLevel(logging.WARNING)

    formatter = logging.Formatter(
        fmt="%(asctime)s | %(levelname)-8s | %(message)s",
        datefmt="%Y-%m-%d %H:%M:%S",
    )
    fh.setFormatter(formatter)
    ch.setFormatter(formatter)

    logger.addHandler(fh)
    logger.addHandler(ch)
    return logger


# Instancia global
logger = _inicializar_logger()


# ── Funciones de conveniencia ───────────────────────────────────────────────

def log_info(mensaje: str) -> None:
    """Registra un evento informativo."""
    logger.info(mensaje)


def log_advertencia(mensaje: str) -> None:
    """Registra una advertencia."""
    logger.warning(mensaje)


def log_error(mensaje: str, excepcion: Exception = None) -> None:
    """Registra un error, opcionalmente con la excepción completa."""
    if excepcion:
        logger.error(f"{mensaje} | Excepción: {excepcion}", exc_info=False)
    else:
        logger.error(mensaje)


def log_critico(mensaje: str, excepcion: Exception = None) -> None:
    """Registra un error crítico del sistema."""
    if excepcion:
        logger.critical(f"{mensaje} | Excepción: {excepcion}", exc_info=True)
    else:
        logger.critical(mensaje)


def log_debug(mensaje: str) -> None:
    """Registra información de depuración."""
    logger.debug(mensaje)


def ruta_log() -> str:
    """Devuelve la ruta absoluta del archivo de log activo."""
    return LOG_FILE

"""
reservas.py
===========
Define la clase Reserva y el GestorReservas del sistema Software FJ.

Ciclo de vida de una reserva:
    PENDIENTE → CONFIRMADA → COMPLETADA
    PENDIENTE → CANCELADA
    CONFIRMADA → CANCELADA

Manejo de excepciones:
- try/except para capturar errores de validación al crear reservas.
- try/except/else para flujos de confirmación y cancelación.
- try/except/finally para garantizar el registro de cada operación en log.
- Encadenamiento de excepciones (raise X from Y).
"""

import uuid
from datetime import datetime
from enum import Enum
from typing import Optional

from entidades import Cliente
from servicios import Servicio
from excepciones import (
    ReservaError,
    ReservaNoEncontradaError,
    ReservaDuplicadaError,
    EstadoReservaInvalidoError,
    DuracionInvalidaError,
    ParametroServicioInvalidoError,
    ServicioNoDisponibleError,
)
from logger import log_info, log_error, log_advertencia, log_debug


# ── Estado de la reserva ────────────────────────────────────────────────────

class EstadoReserva(str, Enum):
    PENDIENTE = "PENDIENTE"
    CONFIRMADA = "CONFIRMADA"
    COMPLETADA = "COMPLETADA"
    CANCELADA = "CANCELADA"


# ── Clase Reserva ───────────────────────────────────────────────────────────

class Reserva:
    """
    Representa una reserva de servicio para un cliente en Software FJ.

    Integra: cliente, servicio, duración y estado.
    Gestiona el ciclo de vida completo con manejo robusto de excepciones.
    """

    def __init__(
        self,
        cliente: Cliente,
        servicio: Servicio,
        duracion: int,
        notas: Optional[str] = None,
        participantes: int = 1,
    ):
        """
        Crea una reserva en estado PENDIENTE.

        Args:
            cliente       : Instancia de Cliente validada.
            servicio      : Instancia de Servicio validada y disponible.
            duracion      : Unidades a reservar (horas, días, sesiones según servicio).
            notas         : Observaciones opcionales.
            participantes : Relevante para AsesoriaEspecializada.

        Raises:
            DuracionInvalidaError       : Si duracion < 1.
            ServicioNoDisponibleError   : Si el servicio no está activo.
            ReservaError                : Para cualquier otro error de creación.
        """
        try:
            # Validar duración
            if not isinstance(duracion, int) or duracion < 1:
                raise DuracionInvalidaError(duracion)

            # Verificar disponibilidad del servicio
            servicio.verificar_disponibilidad()

            self._id = str(uuid.uuid4())[:8].upper()
            self._cliente = cliente
            self._servicio = servicio
            self._duracion = duracion
            self._participantes = participantes
            self._notas = notas or ""
            self._estado = EstadoReserva.PENDIENTE
            self._fecha_creacion = datetime.now()
            self._fecha_actualizacion = self._fecha_creacion
            self._costo: Optional[float] = None

        except (DuracionInvalidaError, ServicioNoDisponibleError):
            raise  # Re-lanza sin encadenar, ya son excepciones propias
        except Exception as e:
            raise ReservaError(
                f"Error inesperado al crear la reserva: {e}"
            ) from e
        else:
            log_info(
                f"Reserva {self._id} creada: cliente={cliente.id}, "
                f"servicio={servicio.obtener_id()}, duración={duracion}"
            )

    # ── Propiedades de solo lectura ─────────────────────────────────────────

    @property
    def id(self) -> str:
        return self._id

    @property
    def cliente(self) -> Cliente:
        return self._cliente

    @property
    def servicio(self) -> Servicio:
        return self._servicio

    @property
    def duracion(self) -> int:
        return self._duracion

    @property
    def estado(self) -> EstadoReserva:
        return self._estado

    @property
    def costo(self) -> Optional[float]:
        return self._costo

    @property
    def fecha_creacion(self) -> datetime:
        return self._fecha_creacion

    # ── Operaciones de ciclo de vida ────────────────────────────────────────

    def confirmar(
        self,
        impuesto: float = 0.0,
        descuento: float = 0.0,
    ) -> float:
        """
        Confirma la reserva y calcula el costo total.

        Args:
            impuesto  : % de IVA u otro impuesto.
            descuento : % de descuento aplicable.

        Returns:
            Costo total calculado.

        Raises:
            EstadoReservaInvalidoError : Si la reserva no está en estado PENDIENTE.
            ReservaError               : Si el cálculo de costo falla.
        """
        try:
            if self._estado != EstadoReserva.PENDIENTE:
                raise EstadoReservaInvalidoError("confirmar", self._estado.value)

            # Intentar calcular el costo (puede lanzar excepciones propias)
            from servicios import AsesoriaEspecializada
            if isinstance(self._servicio, AsesoriaEspecializada):
                costo = self._servicio.calcular_costo(
                    self._duracion, impuesto, descuento, self._participantes
                )
            else:
                costo = self._servicio.calcular_costo(
                    self._duracion, impuesto, descuento
                )

        except EstadoReservaInvalidoError:
            raise
        except Exception as e:
            log_error(f"Error calculando costo para reserva {self._id}", e)
            raise ReservaError(
                f"No se pudo confirmar la reserva {self._id}: {e}"
            ) from e
        else:
            self._costo = costo
            self._estado = EstadoReserva.CONFIRMADA
            self._fecha_actualizacion = datetime.now()
            log_info(
                f"Reserva {self._id} CONFIRMADA | Costo: ${costo:,.2f} | "
                f"Impuesto: {impuesto}% | Descuento: {descuento}%"
            )
            return costo
        finally:
            log_debug(f"Intento de confirmación para reserva {self._id} procesado.")

    def cancelar(self, motivo: str = "Sin motivo especificado") -> None:
        """
        Cancela la reserva si está en estado PENDIENTE o CONFIRMADA.

        Args:
            motivo : Razón de la cancelación.

        Raises:
            EstadoReservaInvalidoError : Si la reserva ya fue completada o cancelada.
        """
        try:
            estados_cancelables = {EstadoReserva.PENDIENTE, EstadoReserva.CONFIRMADA}
            if self._estado not in estados_cancelables:
                raise EstadoReservaInvalidoError("cancelar", self._estado.value)

        except EstadoReservaInvalidoError:
            raise
        except Exception as e:
            raise ReservaError(f"Error al cancelar reserva {self._id}: {e}") from e
        else:
            self._estado = EstadoReserva.CANCELADA
            self._fecha_actualizacion = datetime.now()
            log_info(f"Reserva {self._id} CANCELADA | Motivo: {motivo}")
        finally:
            log_debug(f"Intento de cancelación para reserva {self._id} procesado.")

    def completar(self) -> None:
        """
        Marca la reserva como completada. Solo válido si está CONFIRMADA.

        Raises:
            EstadoReservaInvalidoError : Si no está confirmada.
        """
        try:
            if self._estado != EstadoReserva.CONFIRMADA:
                raise EstadoReservaInvalidoError("completar", self._estado.value)
        except EstadoReservaInvalidoError:
            raise
        else:
            self._estado = EstadoReserva.COMPLETADA
            self._fecha_actualizacion = datetime.now()
            log_info(f"Reserva {self._id} COMPLETADA.")
        finally:
            log_debug(f"Intento de completación para reserva {self._id} procesado.")

    def describir(self) -> str:
        costo_str = f"${self._costo:,.2f}" if self._costo is not None else "Pendiente de cálculo"
        return (
            f"Reserva [{self._id}] | Estado: {self._estado.value} | "
            f"Cliente: {self._cliente.nombre} ({self._cliente.id}) | "
            f"Servicio: {self._servicio.obtener_id()} | "
            f"Duración: {self._duracion} | Costo: {costo_str} | "
            f"Creada: {self._fecha_creacion.strftime('%Y-%m-%d %H:%M')}"
        )

    def __str__(self) -> str:
        return self.describir()


# ── Gestor de Reservas ──────────────────────────────────────────────────────

class GestorReservas:
    """
    Administra todas las reservas del sistema Software FJ.
    Usa listas internas; sin base de datos.
    """

    def __init__(self):
        self._reservas: dict[str, Reserva] = {}

    def crear_reserva(
        self,
        cliente: Cliente,
        servicio: Servicio,
        duracion: int,
        notas: str = "",
        participantes: int = 1,
    ) -> Reserva:
        """
        Crea y registra una nueva reserva.

        Raises:
            ReservaDuplicadaError : Si el cliente ya tiene reserva activa para ese servicio.
        """
        try:
            # Detectar reservas activas duplicadas
            for r in self._reservas.values():
                if (
                    r.cliente.id == cliente.id
                    and r.servicio.obtener_id() == servicio.obtener_id()
                    and r.estado in {EstadoReserva.PENDIENTE, EstadoReserva.CONFIRMADA}
                ):
                    raise ReservaDuplicadaError(cliente.id, servicio.obtener_id())

            reserva = Reserva(cliente, servicio, duracion, notas, participantes)

        except ReservaDuplicadaError:
            raise
        except (DuracionInvalidaError, ServicioNoDisponibleError):
            raise
        except Exception as e:
            raise ReservaError(f"Error al registrar reserva: {e}") from e
        else:
            self._reservas[reserva.id] = reserva
            log_info(f"Reserva {reserva.id} registrada en el gestor.")
            return reserva
        finally:
            log_debug("Operación de creación de reserva finalizada.")

    def obtener(self, reserva_id: str) -> Reserva:
        """Retorna la reserva por ID o lanza ReservaNoEncontradaError."""
        if reserva_id not in self._reservas:
            raise ReservaNoEncontradaError(reserva_id)
        return self._reservas[reserva_id]

    def listar_por_cliente(self, cliente_id: str) -> list[Reserva]:
        """Filtra reservas por ID de cliente."""
        return [r for r in self._reservas.values() if r.cliente.id == cliente_id]

    def listar_por_estado(self, estado: EstadoReserva) -> list[Reserva]:
        """Filtra reservas por estado."""
        return [r for r in self._reservas.values() if r.estado == estado]

    def listar_todas(self) -> list[Reserva]:
        return list(self._reservas.values())

    def total(self) -> int:
        return len(self._reservas)
