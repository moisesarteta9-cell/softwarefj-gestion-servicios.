"""
servicios.py
============
Define la clase abstracta Servicio y los tres servicios especializados
de Software FJ: ReservaSala, AlquilerEquipo y AsesoriaEspecializada.

Principios aplicados:
- Herencia: los tres servicios extienden Servicio y EntidadBase.
- Polimorfismo: cada servicio sobrescribe calcular_costo() y describir().
- Encapsulación: atributos privados con propiedades validadas.
- Sobrecarga simulada: calcular_costo() acepta parámetros opcionales
  (impuesto, descuento) para distintos escenarios de cálculo.
"""

from abc import abstractmethod
from typing import Optional

from entidades import EntidadBase
from excepciones import (
    ServicioNoDisponibleError,
    ParametroServicioInvalidoError,
    DescuentoInvalidoError,
    ImpuestoInvalidoError,
)
from logger import log_info, log_advertencia


# ── Clase abstracta Servicio ────────────────────────────────────────────────

class Servicio(EntidadBase):
    """
    Clase abstracta que representa un servicio ofrecido por Software FJ.
    Toda subclase debe implementar calcular_costo(), describir() y validar().
    """

    def __init__(self, servicio_id: str, nombre: str, tarifa_base: float,
                 disponible: bool = True):
        """
        Args:
            servicio_id  : Identificador único del servicio.
            nombre       : Nombre descriptivo.
            tarifa_base  : Precio base por unidad (hora, día, sesión…).
            disponible   : Si el servicio puede ser reservado actualmente.
        """
        if not servicio_id or not isinstance(servicio_id, str):
            raise ParametroServicioInvalidoError("servicio_id", "no puede estar vacío")
        if not nombre or not isinstance(nombre, str):
            raise ParametroServicioInvalidoError("nombre", "no puede estar vacío")
        if not isinstance(tarifa_base, (int, float)) or tarifa_base <= 0:
            raise ParametroServicioInvalidoError(
                "tarifa_base", "debe ser un número positivo"
            )

        self._id = servicio_id.strip()
        self._nombre = nombre.strip()
        self._tarifa_base = float(tarifa_base)
        self._disponible = bool(disponible)
        log_info(f"Servicio creado: {self._id} | {self._nombre} | tarifa={self._tarifa_base}")

    # ── Propiedades ─────────────────────────────────────────────────────────

    @property
    def tarifa_base(self) -> float:
        return self._tarifa_base

    @property
    def disponible(self) -> bool:
        return self._disponible

    @disponible.setter
    def disponible(self, valor: bool):
        self._disponible = bool(valor)
        estado = "habilitado" if self._disponible else "deshabilitado"
        log_info(f"Servicio {self._id} {estado}.")

    # ── Métodos de EntidadBase ──────────────────────────────────────────────

    def obtener_id(self) -> str:
        return self._id

    def validar(self) -> bool:
        return bool(self._id) and self._tarifa_base > 0

    # ── Método abstracto principal ──────────────────────────────────────────

    @abstractmethod
    def calcular_costo(
        self,
        duracion: int,
        impuesto: float = 0.0,
        descuento: float = 0.0,
    ) -> float:
        """
        Calcula el costo total del servicio.

        Args:
            duracion  : Unidades de tiempo a reservar (horas, días, sesiones…).
            impuesto  : Porcentaje de impuesto a aplicar (0–100). Default 0.
            descuento : Porcentaje de descuento a aplicar (0–100). Default 0.

        Returns:
            Costo total como float.
        """
        ...

    # ── Validaciones de parámetros opcionales compartidas ───────────────────

    @staticmethod
    def _validar_impuesto(impuesto: float) -> None:
        if not isinstance(impuesto, (int, float)) or not (0 <= impuesto <= 100):
            raise ImpuestoInvalidoError(impuesto)

    @staticmethod
    def _validar_descuento(descuento: float) -> None:
        if not isinstance(descuento, (int, float)) or not (0 <= descuento <= 100):
            raise DescuentoInvalidoError(descuento)

    @staticmethod
    def _aplicar_impuesto_descuento(
        subtotal: float, impuesto: float, descuento: float
    ) -> float:
        """Aplica descuento primero y luego impuesto sobre el subtotal."""
        Servicio._validar_impuesto(impuesto)
        Servicio._validar_descuento(descuento)
        monto_descuento = subtotal * (descuento / 100)
        base_gravable = subtotal - monto_descuento
        monto_impuesto = base_gravable * (impuesto / 100)
        return round(base_gravable + monto_impuesto, 2)

    def verificar_disponibilidad(self) -> None:
        """Lanza excepción si el servicio no está disponible."""
        if not self._disponible:
            raise ServicioNoDisponibleError(self._id)


# ── Servicio 1: Reserva de Sala ─────────────────────────────────────────────

class ReservaSala(Servicio):
    """
    Servicio de reserva de salas de reunión o conferencia.

    Unidad de tiempo: horas.
    Cargo adicional por equipamiento multimedia (opcional).
    """

    CAPACIDAD_MIN = 1
    CAPACIDAD_MAX = 200

    def __init__(
        self,
        servicio_id: str,
        nombre: str,
        tarifa_base: float,
        capacidad: int,
        tiene_multimedia: bool = False,
        cargo_multimedia: float = 0.0,
        disponible: bool = True,
    ):
        super().__init__(servicio_id, nombre, tarifa_base, disponible)

        if not isinstance(capacidad, int) or not (
            self.CAPACIDAD_MIN <= capacidad <= self.CAPACIDAD_MAX
        ):
            raise ParametroServicioInvalidoError(
                "capacidad",
                f"debe ser entero entre {self.CAPACIDAD_MIN} y {self.CAPACIDAD_MAX}",
            )
        self._capacidad = capacidad
        self._tiene_multimedia = bool(tiene_multimedia)
        self._cargo_multimedia = float(cargo_multimedia) if tiene_multimedia else 0.0

    @property
    def capacidad(self) -> int:
        return self._capacidad

    def calcular_costo(
        self,
        duracion: int,
        impuesto: float = 0.0,
        descuento: float = 0.0,
    ) -> float:
        """
        Costo = (tarifa_base × horas) + cargo_multimedia_por_hora.
        Aplicar descuento y luego impuesto.
        """
        self.verificar_disponibilidad()
        if not isinstance(duracion, int) or duracion < 1:
            raise ParametroServicioInvalidoError("duracion", "debe ser entero >= 1")

        subtotal = (self._tarifa_base + self._cargo_multimedia) * duracion
        total = self._aplicar_impuesto_descuento(subtotal, impuesto, descuento)
        log_info(
            f"Costo ReservaSala [{self._id}]: horas={duracion}, "
            f"subtotal={subtotal}, total={total}"
        )
        return total

    def describir(self) -> str:
        multimedia = "Sí" if self._tiene_multimedia else "No"
        return (
            f"[SALA] {self._nombre} (ID: {self._id}) | "
            f"Capacidad: {self._capacidad} personas | "
            f"Tarifa/hora: ${self._tarifa_base:,.2f} | "
            f"Multimedia: {multimedia} (+${self._cargo_multimedia:,.2f}/h) | "
            f"Disponible: {'Sí' if self._disponible else 'No'}"
        )

    def validar(self) -> bool:
        return super().validar() and self._capacidad >= 1


# ── Servicio 2: Alquiler de Equipo ──────────────────────────────────────────

class AlquilerEquipo(Servicio):
    """
    Servicio de alquiler de equipos tecnológicos.

    Unidad de tiempo: días.
    Puede incluir cargo de seguro por daño.
    """

    def __init__(
        self,
        servicio_id: str,
        nombre: str,
        tarifa_base: float,
        tipo_equipo: str,
        requiere_seguro: bool = False,
        tarifa_seguro_diaria: float = 0.0,
        disponible: bool = True,
    ):
        super().__init__(servicio_id, nombre, tarifa_base, disponible)

        if not tipo_equipo or not isinstance(tipo_equipo, str):
            raise ParametroServicioInvalidoError("tipo_equipo", "no puede estar vacío")
        self._tipo_equipo = tipo_equipo.strip()
        self._requiere_seguro = bool(requiere_seguro)
        self._tarifa_seguro = float(tarifa_seguro_diaria) if requiere_seguro else 0.0

    def calcular_costo(
        self,
        duracion: int,
        impuesto: float = 0.0,
        descuento: float = 0.0,
    ) -> float:
        """
        Costo = (tarifa_base + seguro_diario) × días.
        """
        self.verificar_disponibilidad()
        if not isinstance(duracion, int) or duracion < 1:
            raise ParametroServicioInvalidoError("duracion", "debe ser entero >= 1")

        subtotal = (self._tarifa_base + self._tarifa_seguro) * duracion
        total = self._aplicar_impuesto_descuento(subtotal, impuesto, descuento)
        log_info(
            f"Costo AlquilerEquipo [{self._id}]: días={duracion}, "
            f"subtotal={subtotal}, total={total}"
        )
        return total

    def describir(self) -> str:
        seguro = f"${self._tarifa_seguro:,.2f}/día" if self._requiere_seguro else "No incluido"
        return (
            f"[EQUIPO] {self._nombre} (ID: {self._id}) | "
            f"Tipo: {self._tipo_equipo} | "
            f"Tarifa/día: ${self._tarifa_base:,.2f} | "
            f"Seguro: {seguro} | "
            f"Disponible: {'Sí' if self._disponible else 'No'}"
        )

    def validar(self) -> bool:
        return super().validar() and bool(self._tipo_equipo)


# ── Servicio 3: Asesoría Especializada ──────────────────────────────────────

class AsesoriaEspecializada(Servicio):
    """
    Servicio de asesoría profesional (consultoría, capacitación, auditoría…).

    Unidad de tiempo: sesiones.
    Puede incluir tarifa extra por especialización o número de participantes.
    """

    AREAS_VALIDAS = {
        "tecnologia", "legal", "financiero", "rrhh",
        "marketing", "seguridad", "auditoria", "general",
    }

    def __init__(
        self,
        servicio_id: str,
        nombre: str,
        tarifa_base: float,
        area: str,
        max_participantes: int = 10,
        cargo_extra_por_participante: float = 0.0,
        disponible: bool = True,
    ):
        super().__init__(servicio_id, nombre, tarifa_base, disponible)

        area_lower = area.strip().lower() if isinstance(area, str) else ""
        if area_lower not in self.AREAS_VALIDAS:
            raise ParametroServicioInvalidoError(
                "area",
                f"debe ser una de: {', '.join(sorted(self.AREAS_VALIDAS))}",
            )
        if not isinstance(max_participantes, int) or max_participantes < 1:
            raise ParametroServicioInvalidoError(
                "max_participantes", "debe ser entero >= 1"
            )

        self._area = area_lower
        self._max_participantes = max_participantes
        self._cargo_extra = float(cargo_extra_por_participante)

    def calcular_costo(
        self,
        duracion: int,
        impuesto: float = 0.0,
        descuento: float = 0.0,
        participantes: int = 1,
    ) -> float:
        """
        Costo = (tarifa_base × sesiones) + (cargo_extra × participantes_adicionales × sesiones).
        El primer participante está incluido en la tarifa base.

        Args:
            duracion      : Número de sesiones.
            impuesto      : % de impuesto.
            descuento     : % de descuento.
            participantes : Número total de participantes (default 1).
        """
        self.verificar_disponibilidad()
        if not isinstance(duracion, int) or duracion < 1:
            raise ParametroServicioInvalidoError("duracion", "debe ser entero >= 1")
        if not isinstance(participantes, int) or participantes < 1:
            raise ParametroServicioInvalidoError(
                "participantes", "debe ser entero >= 1"
            )
        if participantes > self._max_participantes:
            raise ParametroServicioInvalidoError(
                "participantes",
                f"excede el máximo permitido de {self._max_participantes}",
            )

        extra = max(0, participantes - 1) * self._cargo_extra
        subtotal = (self._tarifa_base + extra) * duracion
        total = self._aplicar_impuesto_descuento(subtotal, impuesto, descuento)
        log_info(
            f"Costo AsesoriaEspecializada [{self._id}]: sesiones={duracion}, "
            f"participantes={participantes}, subtotal={subtotal}, total={total}"
        )
        return total

    def describir(self) -> str:
        return (
            f"[ASESORIA] {self._nombre} (ID: {self._id}) | "
            f"Área: {self._area.capitalize()} | "
            f"Tarifa/sesión: ${self._tarifa_base:,.2f} | "
            f"Máx. participantes: {self._max_participantes} | "
            f"Cargo extra/participante: ${self._cargo_extra:,.2f} | "
            f"Disponible: {'Sí' if self._disponible else 'No'}"
        )

    def validar(self) -> bool:
        return super().validar() and self._area in self.AREAS_VALIDAS


# ── Catálogo de Servicios ───────────────────────────────────────────────────

class CatalogoServicios:
    """
    Almacena y gestiona todos los servicios del sistema Software FJ.
    Usa una lista interna (dict) sin base de datos.
    """

    def __init__(self):
        self._servicios: dict[str, Servicio] = {}

    def agregar(self, servicio: Servicio) -> None:
        from excepciones import ServicioError
        if servicio.obtener_id() in self._servicios:
            raise ServicioError(
                f"Ya existe un servicio con ID '{servicio.obtener_id()}'."
            )
        self._servicios[servicio.obtener_id()] = servicio
        log_info(f"Servicio registrado en catálogo: {servicio.obtener_id()}")

    def obtener(self, servicio_id: str) -> Servicio:
        from excepciones import ServicioNoEncontradoError
        if servicio_id not in self._servicios:
            raise ServicioNoEncontradoError(servicio_id)
        return self._servicios[servicio_id]

    def listar(self) -> list[Servicio]:
        return list(self._servicios.values())

    def total(self) -> int:
        return len(self._servicios)

"""
entidades.py
============
Define la clase abstracta EntidadBase y la clase Cliente con
encapsulación robusta y validaciones estrictas.
"""

import re
from abc import ABC, abstractmethod
from typing import Optional

from excepciones import (
    DatosClienteInvalidosError,
    ClienteYaExisteError,
    ClienteNoEncontradoError,
)
from logger import log_info, log_error, log_advertencia


# ── Clase abstracta base ────────────────────────────────────────────────────

class EntidadBase(ABC):
    """
    Clase abstracta que representa cualquier entidad registrable del sistema.
    Obliga a todas las subclases a implementar identificación y representación.
    """

    @abstractmethod
    def obtener_id(self) -> str:
        """Retorna el identificador único de la entidad."""
        ...

    @abstractmethod
    def describir(self) -> str:
        """Devuelve una descripción legible de la entidad."""
        ...

    @abstractmethod
    def validar(self) -> bool:
        """Valida que la entidad tenga datos consistentes e íntegros."""
        ...

    def __repr__(self) -> str:
        return f"<{self.__class__.__name__} id={self.obtener_id()}>"


# ── Clase Cliente ───────────────────────────────────────────────────────────

class Cliente(EntidadBase):
    """
    Representa un cliente de Software FJ.

    Atributos encapsulados (acceso solo mediante propiedades):
        _id         : Identificador único (alfanumérico, 3-20 chars)
        _nombre     : Nombre completo (mínimo 3 chars, solo letras y espacios)
        _email      : Correo electrónico con formato válido
        _telefono   : Teléfono opcional (solo dígitos, 7-15 chars)
    """

    # Expresiones regulares de validación
    _RE_ID = re.compile(r"^[A-Za-z0-9_\-]{3,20}$")
    _RE_EMAIL = re.compile(r"^[\w.\-+]+@[\w\-]+\.[a-zA-Z]{2,}$")
    _RE_TELEFONO = re.compile(r"^\d{7,15}$")
    _RE_NOMBRE = re.compile(r"^[A-Za-záéíóúÁÉÍÓÚñÑüÜ ]{3,80}$")

    def __init__(
        self,
        cliente_id: str,
        nombre: str,
        email: str,
        telefono: Optional[str] = None,
    ):
        """
        Inicializa un cliente aplicando validaciones estrictas.

        Args:
            cliente_id : Identificador único del cliente.
            nombre     : Nombre completo.
            email      : Correo electrónico.
            telefono   : Número de teléfono (opcional).

        Raises:
            DatosClienteInvalidosError: Si algún dato no supera la validación.
        """
        # Asignación mediante setters para aplicar validaciones desde el inicio
        self.id = cliente_id          # usa el setter
        self.nombre = nombre
        self.email = email
        self.telefono = telefono      # puede ser None
        log_info(f"Cliente creado: {self._id} | {self._nombre} | {self._email}")

    # ── Propiedades (getters y setters con validación) ──────────────────────

    @property
    def id(self) -> str:
        return self._id

    @id.setter
    def id(self, valor: str):
        if not isinstance(valor, str) or not self._RE_ID.match(valor.strip()):
            raise DatosClienteInvalidosError(
                "id",
                str(valor),
            )
        self._id = valor.strip()

    @property
    def nombre(self) -> str:
        return self._nombre

    @nombre.setter
    def nombre(self, valor: str):
        if not isinstance(valor, str) or not self._RE_NOMBRE.match(valor.strip()):
            raise DatosClienteInvalidosError("nombre", str(valor))
        self._nombre = valor.strip()

    @property
    def email(self) -> str:
        return self._email

    @email.setter
    def email(self, valor: str):
        if not isinstance(valor, str) or not self._RE_EMAIL.match(valor.strip()):
            raise DatosClienteInvalidosError("email", str(valor))
        self._email = valor.strip().lower()

    @property
    def telefono(self) -> Optional[str]:
        return self._telefono

    @telefono.setter
    def telefono(self, valor: Optional[str]):
        if valor is None:
            self._telefono = None
            return
        if not isinstance(valor, str) or not self._RE_TELEFONO.match(valor.strip()):
            raise DatosClienteInvalidosError("telefono", str(valor))
        self._telefono = valor.strip()

    # ── Métodos de EntidadBase ──────────────────────────────────────────────

    def obtener_id(self) -> str:
        return self._id

    def describir(self) -> str:
        tel = self._telefono if self._telefono else "N/A"
        return (
            f"Cliente [{self._id}] | Nombre: {self._nombre} | "
            f"Email: {self._email} | Teléfono: {tel}"
        )

    def validar(self) -> bool:
        """Revalida todos los campos del cliente."""
        try:
            assert self._RE_ID.match(self._id)
            assert self._RE_NOMBRE.match(self._nombre)
            assert self._RE_EMAIL.match(self._email)
            if self._telefono:
                assert self._RE_TELEFONO.match(self._telefono)
            return True
        except AssertionError:
            return False

    def __str__(self) -> str:
        return self.describir()


# ── Repositorio de Clientes ─────────────────────────────────────────────────

class RepositorioClientes:
    """
    Gestiona la colección de clientes del sistema usando una lista interna.
    No usa bases de datos; toda la información reside en memoria.
    """

    def __init__(self):
        self._clientes: dict[str, Cliente] = {}

    def agregar(self, cliente: Cliente) -> None:
        """
        Registra un nuevo cliente en el sistema.

        Raises:
            ClienteYaExisteError: Si el ID ya está registrado.
        """
        if cliente.id in self._clientes:
            raise ClienteYaExisteError(cliente.id)
        self._clientes[cliente.id] = cliente
        log_info(f"Cliente registrado en repositorio: {cliente.id}")

    def obtener(self, cliente_id: str) -> Cliente:
        """
        Retorna el cliente con el ID dado.

        Raises:
            ClienteNoEncontradoError: Si el ID no existe.
        """
        if cliente_id not in self._clientes:
            raise ClienteNoEncontradoError(cliente_id)
        return self._clientes[cliente_id]

    def listar(self) -> list[Cliente]:
        """Devuelve una lista de todos los clientes registrados."""
        return list(self._clientes.values())

    def total(self) -> int:
        """Retorna el número de clientes registrados."""
        return len(self._clientes)

    def existe(self, cliente_id: str) -> bool:
        """Indica si un cliente con el ID dado está registrado."""
        return cliente_id in self._clientes

"""
excepciones.py
==============
Excepciones personalizadas para el sistema Software FJ.
Todas heredan de SoftwareFJError para permitir captura general del sistema.
"""


class SoftwareFJError(Exception):
    """Excepción base del sistema Software FJ."""

    def __init__(self, mensaje: str, codigo: str = "ERR_GENERAL"):
        super().__init__(mensaje)
        self.mensaje = mensaje
        self.codigo = codigo

    def __str__(self):
        return f"[{self.codigo}] {self.mensaje}"


# ── Errores de Cliente ──────────────────────────────────────────────────────

class ClienteError(SoftwareFJError):
    """Error relacionado con operaciones de clientes."""

    def __init__(self, mensaje: str):
        super().__init__(mensaje, "ERR_CLIENTE")


class ClienteYaExisteError(ClienteError):
    """Se intenta registrar un cliente con ID ya existente."""

    def __init__(self, cliente_id: str):
        super().__init__(f"El cliente con ID '{cliente_id}' ya existe en el sistema.")
        self.cliente_id = cliente_id


class ClienteNoEncontradoError(ClienteError):
    """El cliente solicitado no existe en el sistema."""

    def __init__(self, cliente_id: str):
        super().__init__(f"No se encontró ningún cliente con ID '{cliente_id}'.")
        self.cliente_id = cliente_id


class DatosClienteInvalidosError(ClienteError):
    """Los datos proporcionados para el cliente son inválidos."""

    def __init__(self, campo: str, valor: str):
        super().__init__(f"Dato inválido en campo '{campo}': '{valor}'.")
        self.campo = campo
        self.valor = valor


# ── Errores de Servicio ─────────────────────────────────────────────────────

class ServicioError(SoftwareFJError):
    """Error relacionado con servicios."""

    def __init__(self, mensaje: str):
        super().__init__(mensaje, "ERR_SERVICIO")


class ServicioNoDisponibleError(ServicioError):
    """El servicio solicitado no está disponible."""

    def __init__(self, servicio_id: str):
        super().__init__(f"El servicio '{servicio_id}' no está disponible actualmente.")
        self.servicio_id = servicio_id


class ServicioNoEncontradoError(ServicioError):
    """El servicio no existe en el catálogo."""

    def __init__(self, servicio_id: str):
        super().__init__(f"No se encontró el servicio con ID '{servicio_id}'.")
        self.servicio_id = servicio_id


class ParametroServicioInvalidoError(ServicioError):
    """Un parámetro del servicio es inválido."""

    def __init__(self, parametro: str, razon: str):
        super().__init__(f"Parámetro inválido '{parametro}': {razon}.")
        self.parametro = parametro


# ── Errores de Reserva ──────────────────────────────────────────────────────

class ReservaError(SoftwareFJError):
    """Error relacionado con reservas."""

    def __init__(self, mensaje: str):
        super().__init__(mensaje, "ERR_RESERVA")


class ReservaNoEncontradaError(ReservaError):
    """La reserva solicitada no existe."""

    def __init__(self, reserva_id: str):
        super().__init__(f"No se encontró la reserva con ID '{reserva_id}'.")
        self.reserva_id = reserva_id


class ReservaDuplicadaError(ReservaError):
    """Intento de crear una reserva duplicada."""

    def __init__(self, cliente_id: str, servicio_id: str):
        super().__init__(
            f"El cliente '{cliente_id}' ya tiene una reserva activa para el servicio '{servicio_id}'."
        )


class EstadoReservaInvalidoError(ReservaError):
    """Operación no permitida para el estado actual de la reserva."""

    def __init__(self, operacion: str, estado_actual: str):
        super().__init__(
            f"No se puede ejecutar '{operacion}' sobre una reserva en estado '{estado_actual}'."
        )
        self.operacion = operacion
        self.estado_actual = estado_actual


class DuracionInvalidaError(ReservaError):
    """La duración especificada no es válida."""

    def __init__(self, duracion, minimo: int = 1):
        super().__init__(
            f"Duración inválida: '{duracion}'. Debe ser un entero mayor o igual a {minimo}."
        )
        self.duracion = duracion


# ── Errores de Cálculo ──────────────────────────────────────────────────────

class CalculoError(SoftwareFJError):
    """Error durante cálculos de costos o tarifas."""

    def __init__(self, mensaje: str):
        super().__init__(mensaje, "ERR_CALCULO")


class DescuentoInvalidoError(CalculoError):
    """El porcentaje de descuento está fuera de rango."""

    def __init__(self, descuento: float):
        super().__init__(
            f"Descuento inválido: {descuento}%. Debe estar entre 0 y 100."
        )
        self.descuento = descuento


class ImpuestoInvalidoError(CalculoError):
    """La tasa de impuesto es negativa o excesiva."""

    def __init__(self, impuesto: float):
        super().__init__(
            f"Tasa de impuesto inválida: {impuesto}%. Debe estar entre 0 y 100."
        )
        self.impuesto = impuesto

